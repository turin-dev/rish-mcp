# Hostnames routed by the external Traefik/Dokploy network.
MCP_HOST=mcp.example.com
PUBLIC_MCP_HOST=dl.example.com

# Comma-separated IPs of reverse proxies allowed to set X-Forwarded-For.
# Leave empty when the service is reachable directly.
TRUSTED_PROXIES=

# Generate both secrets with: openssl rand -hex 32
AI_TOKEN=replace-with-a-long-random-secret
DEVICE_TOKEN=replace-with-a-long-random-secret

# Optional release and runtime tuning.
GITHUB_REPO=turin-dev/rish-mcp
DEFAULT_TIMEOUT_MS=60000
MAX_TIMEOUT_MS=600000
DOWNLOADS_PER_HOUR=30
RELEASE_POLL_MS=900000
