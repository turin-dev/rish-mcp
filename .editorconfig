root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{kt,kts}]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
