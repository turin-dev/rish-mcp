<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ADB wireless-debugging pairing/connect (loopback) needs network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Minimal shell for this step: only AdbShellClient (docs/DESIGN.md §2.1/§3.1).
      MainActivity/AgentService/BootReceiver come back once they're rewired to
      use it instead of the old Shizuku ShellUserService.
    -->
    <application android:allowBackup="false" />
</manifest>
